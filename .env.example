# Plantilla de entorno de TasasGo. Copiar a .env y completar valores reales.
# NUNCA escribir credenciales reales en este archivo: se versiona.

# Puerto HTTP del servicio. Node usa 3002; Go usa 3003 para poder coexistir.
PORT=3003

# Entorno de ejecución: development | production.
# Con "production" NO se carga el archivo .env: las variables deben venir del sistema.
APP_ENV=development

# PostgreSQL (Para local usa localhost; en el VPS Easypanel el host es automat_postgres-db)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_NAME=automat
DB_SSLMODE=disable

# Evolution API (WhatsApp).
# Si EVOLUTION_API_URL queda vacío, el cliente entra en modo simulación y no toca la red.
EVOLUTION_API_URL=https://automatizaciones-evolution-api.eo3pev.easypanel.host
EVOLUTION_API_KEY=tu_api_key_aqui
EVOLUTION_INSTANCE=Glauk
JID_GRUPO_PRUEBA=tu_jid_de_prueba@g.us

# Origen externo de tasas globales (HOO). Es público y no requiere credencial.
HOO_GLOBAL_RATES_URL=https://hoo.jairokov.com/global-rates